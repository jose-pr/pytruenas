from __future__ import annotations

from pytruenas import Namespace as _NS
from pytruenas.models import jsonschema as _jsonschema
import sys
import typing as _ty

# Never, NotRequired and Unpack are typing members only from 3.11; this
# project's floor -- and so a consumer's checking target -- is 3.9. `sys` is not
# aliased: mypy reads a version check only on the module's own name.
if sys.version_info >= (3, 11):
    from typing import Never as _Never, NotRequired as _NotRequired, Unpack as _Unpack
else:
    from typing_extensions import (
        Never as _Never,
        NotRequired as _NotRequired,
        Unpack as _Unpack,
    )

{%- set typeddicts = {} -%}

{% for qn in ns.namespaces() %}
from .{{ qn.pyname.relative_to(ns.pyname) }} import {{ qn.classname }}
{%- endfor %}


class {{ ns.classname }}(_NS):
    {% for qn in ns.methods() %}
    def {{ qn.pyname.name }}(self,
        {%- if qn.overrides_runtime %}  # type: ignore[override]{% endif %}
        {%- for decl in qn.declared_parameters(typeddicts) %}
        {{ decl }},
        {%- endfor %}
    ) -> {{ qn.returns.type_def(typeddicts) }}:
        """{{ docstring(qn.doc) }}"""
        ...
    {%- endfor %}
    {%- for qn in ns.namespaces() %}
    {{ qn.pyname.name }}: {{ qn.classname }}
    {%- endfor %}
    {%- if not ns.methods() and not ns.namespaces() %}
    pass
    {%- endif %}

{% for name, properties in typeddicts.items() %}
{{ name }} = _ty.TypedDict('{{ name }}', {
{%- for prop, typedef in properties.items() %}
    {{ prop | tojson }}: {{ typedef }},
{%- endfor %}
})
{% endfor %}
{%- if alias %}

#: The documented spelling: `TrueNASClient[Current]`, so a consumer pins "the
#: version these typings were generated from" without naming it.
{{ alias }} = {{ ns.classname }}
{%- endif %}
